# Copy this file to .env in the project root, next to requirements.txt.
# Get your Gemini API key from https://aistudio.google.com/apikey
# Never commit .env or put your real key in this example file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_PATH=data/resume_analyzer.db

# Required resume RAG uses the same key. Old resume indexes are refreshed automatically when the model changes.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
